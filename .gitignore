# Environment files (deployment.md section 3). Only .env.example is committed.
.env
.env.*
!.env.example

# Secrets and key material (deployment.md section 3). Only secrets.example/ placeholders are committed.
secrets/
*.pem
*.key
*keyring*
*key-ring*
*key_ring*
# Source code and documents may use these words in their names; they hold no key material.
!*.ts
!*.tsx
!*.js
!*.jsx
!*.mjs
!*.cjs
!*.md
!*.py
!secrets.example/
!secrets.example/**

# Build and test output
coverage/
__pycache__/
node_modules/
dist/

# Local agent working folders and workflow worktrees (never committed)
.agents/
.worktrees/

# Operating system files
.DS_Store
